# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Server-Only Service Role Key (NEVER expose to the client or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=NovaStage <onboarding@resend.dev>

# AI Model Configuration (Supports Google Gemini or OpenAI)
# Optional: Set AI_PROVIDER=openai or AI_PROVIDER=gemini (defaults to gemini if GEMINI_API_KEY is present)
AI_PROVIDER=gemini

# Google Gemini AI Configuration (Get free API key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash
GEMINI_FREE_ONLY=true

# OpenAI Configuration (Optional alternate provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Upstash Redis Configuration (Distributed editing leases & rate limiting)
# Optional: falls back gracefully to in-memory or database locks if unconfigured
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
